@startuml 02-azure-seed
!include _c4.iuml
title demo-agentic-system1 | Phase 2: Azure seed (2026-10-17)

Boundary(box, "Operator machine grok-bot-vm-301204161") {
  Container(aiops, "Linux user box", "az as cm-ai-ops", "Ran new-demo-seed.ps1: seed.bicep at subscription scope")
}

Boundary(sub, "Subscription Jeffrey MVP Azure subscription 7-25--7-27 (eastus2)") {
  Boundary(rgn, "rg-agentic1-nonprod") {
    ContainerDb(acr, "acragentic125tqid", "Container Registry, Basic", "Images agentic1/ui:<version>", $tags="new")
    ContainerDb(tfstate, "stagentic1tf25tqid", "Storage account", "Terraform state of octopus/ (container tfstate)", $tags="new")
    Container(id_plan, "id-agentic1-plan", "managed identity", "Reader on both groups: what-if previews and drift", $tags="new")
    Container(id_cfg, "id-agentic1-octopus-config", "managed identity", "Storage Blob Data Contributor on the state account", $tags="new")
    Container(id_push, "id-agentic1-acr-push", "managed identity", "AcrPush on the registry", $tags="new")
    Container(id_dn, "id-agentic1-deploy-nonprod", "managed identity", "Owner of rg-agentic1-nonprod: applies the stacks of tdd, uat", $tags="new")
    Container(id_apps_n, "Runtime identities", "managed identities", "id-agentic1-tdd-app, id-agentic1-uat-app: AcrPull", $tags="new")
  }
  Boundary(rgp, "rg-agentic1-prod") {
    Container(id_dp, "id-agentic1-deploy-prod", "managed identity", "Owner of rg-agentic1-prod: applies the stacks of prod", $tags="new")
    Container(id_apps_p, "Runtime identities", "managed identities", "id-agentic1-prod-app: AcrPull", $tags="new")
  }
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "demo-agentic-system1-system", "environments azure-read, octopus", $tags="planned")
  Container(apprepo, "demo-agentic-system1-workorders", "environment release", $tags="planned")
}

Boundary(octo, "Octopus space demo-agentic-system1") {
  Container(projects, "Projects agentic1-system, agentic1-ui", "deployments per environment", "OIDC subjects space:demo-agentic-system1:project:<project>:environment:<env>", $tags="planned")
}

Rel(aiops, sub, "deployment seed-agentic1", "Owner", $tags="new")
Rel(sysrepo, id_plan, "federated: environment azure-read", $tags="planned")
Rel(sysrepo, id_cfg, "federated: environment octopus", $tags="planned")
Rel(apprepo, id_push, "federated: environment release", $tags="planned")
Rel(projects, id_dn, "federated: nonprod environments", $tags="planned")
Rel(projects, id_dp, "federated: prod environments", $tags="planned")
Rel(id_cfg, tfstate, "state", $tags="new")
Rel(id_push, acr, "push", $tags="new")

SHOW_LEGEND()
@enduml
