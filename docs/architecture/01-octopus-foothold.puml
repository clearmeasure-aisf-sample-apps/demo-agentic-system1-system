@startuml 01-octopus-foothold
!include _c4.iuml
title demo-agentic-system1 | Phase 1: Octopus foothold (2026-10-17)

Boundary(box, "Operator machine grok-bot-vm-301204161") {
  Container(aiops, "Linux user box", "Claude Code, gh, az, pwsh", "Ran new-octopus-foothold.ps1")
}

Boundary(octo, "Octopus https://clearmeasure.octopus.app") {
  Container(aiops_octo, "ai-ops", "AI service account", "Octopus Managers")
  Boundary(space, "Space demo-agentic-system1 (Spaces-415, slug demo-agentic-system1)") {
    Container(sa, "agentic1-github", "service account Users-882, Space Manager", "No password, no API key: GitHub signs in with OIDC (ExternalId dee30260-3377-44c8-987b-9487828f7c65)", $tags="new")
    Container(oidc_sys, "OIDC identity", "issuer token.actions.githubusercontent.com", "repo:clearmeasure-aisf-sample-apps/demo-agentic-system1-system:environment:octopus", $tags="new")
    Container(oidc_app, "OIDC identity", "issuer token.actions.githubusercontent.com", "repo:clearmeasure-aisf-sample-apps/demo-agentic-system1-workorders:environment:release", $tags="new")
  }
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "demo-agentic-system1-system", "environment octopus", "Jobs octopus-apply and system-release", $tags="planned")
  Container(apprepo, "demo-agentic-system1-workorders", "environment release", "Workflow release.yml", $tags="planned")
}

Rel(aiops, aiops_octo, "REST", "API key")
Rel(aiops_octo, space, "created; Space Manager", $tags="new")
Rel(oidc_sys, sa, "signs in as", $tags="new")
Rel(oidc_app, sa, "signs in as", $tags="new")
Rel(sysrepo, oidc_sys, "OIDC token", $tags="planned")
Rel(apprepo, oidc_app, "OIDC token", $tags="planned")

SHOW_LEGEND()
@enduml
